{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/wp/6.8/schemas/json/theme.json",
	"version": 3,
	"title": "Notes",
	"settings": {
		"custom": {
			"variation": "notes",
			"border": {
				"global": {
					"radius": "0.75rem"
				},
				"button": {
					"radius": "9999em"
				}
			},
			"layout": {
				"containerSize": "56rem"
			}
		}
	},
	"styles": {
		"css": "@layer variation { body { background: var(--wp--preset--gradient--emerge); } } .is-root-container.wp-block-post-content { max-width: 56rem; margin-left: auto; margin-right: auto; }",
		"color": {
			"gradient": "var(--wp--preset--gradient--emerge)",
			"text": "var(--wp--preset--color--white)"
		},
		"variations": {
			"site-container": {
				"css": "contain: paint; max-width: var(--wp--custom--layout--container-size); width: 100%; & > * { margin-top: 0; }",
				"border": {
					"radius": "clamp(0rem, calc(0.23583 * (100cqi - 56rem)), var(--wp--custom--border--global--radius))"
				},
				"shadow": "var(--wp--custom--shadow--global--default)",
				"spacing": {
					"margin": {
						"top": "clamp(0rem, calc(0.23583 * (100cqi - 56rem)), 5.66rem) !important",
						"bottom": "clamp(0rem, calc(0.23583 * (100cqi - 56rem)), 5.66rem) !important",
						"left": "auto",
						"right": "auto"
					}
				}
			}
		}
	}
}
